{
  "name": "@quezby/sdk",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "react-native": "./src/admin.ts",
      "types": "./dist/admin.d.ts",
      "import": "./dist/esm/admin.js",
      "require": "./dist/admin.js",
      "default": "./dist/admin.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build": "tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}\\n')\"",
    
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": { "@quezby/types": "workspace:*" },
  "devDependencies": {
    "@quezby/tsconfig": "workspace:*",
    "@types/node": "^22.18.0",
    
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
