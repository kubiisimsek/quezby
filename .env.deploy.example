# `pnpm deploy:staging` / `pnpm deploy:production` from your own computer
# (scripts/deploy.mjs). Copy to .env.deploy, which git ignores. On GitHub the
# same names come from the repository's secrets and variables instead.

# cPanel → Manage API Tokens
DEPLOY_CPANEL_USER=
DEPLOY_CPANEL_TOKEN=

# Folders relative to the cPanel home; each must be empty, new, or already hold its part.
DEPLOY_STAGING_API_DIR=quezby-api-staging
DEPLOY_STAGING_ADMIN_DIR=
DEPLOY_PROD_API_DIR=public_html/api
DEPLOY_PROD_ADMIN_DIR=public_html/panel
