{
  "name": "quezby",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:packages": "turbo run build --filter=./packages/*",
    "dev:mobile": "pnpm --filter @quezby/mobile dev",
    "dev:admin": "turbo run dev --filter=@quezby/admin",
    "dev:api": "cd apps/api && php artisan serve --host=0.0.0.0 --port=8000",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:api": "cd apps/api && php artisan test",
    "clean": "turbo run clean && rm -rf .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "pnpm --filter @quezby/mobile start",
    "pods": "pnpm --filter @quezby/mobile pods",
    "ios": "pnpm --filter @quezby/mobile ios",
    "android": "pnpm --filter @quezby/mobile android",
    "switch-local": "node scripts/switch-env.mjs local",
    "switch-staging": "node scripts/switch-env.mjs staging",
    "switch-production": "node scripts/switch-env.mjs production",
    "engine:fixtures": "pnpm --filter @quezby/engine fixtures",
    "engine:simulate": "pnpm --filter @quezby/engine simulate",
    "engine:lock": "pnpm --filter @quezby/engine lock",
    "tokens": "node scripts/sync-design-tokens.mjs",
    "fonts:cjk": "node scripts/cjk-fonts.mjs",
    "api:package:staging": "./scripts/package-api.sh staging",
    "api:package:production": "./scripts/package-api.sh production",
    "admin:package:staging": "node scripts/package-admin.mjs staging",
    "admin:package:production": "node scripts/package-admin.mjs production",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "android:bundle:staging": "node scripts/package-android.mjs staging",
    "android:bundle:production": "node scripts/package-android.mjs production"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "subset-font": "^2.9.0",
    "turbo": "^2.10.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
