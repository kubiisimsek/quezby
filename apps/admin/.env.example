# The admin panel ships everything in this file to the browser: a VITE_*
# value is public. Never put a token or a secret here.
#
# Leave it empty: `pnpm dev:admin` proxies /api to php artisan serve on :8000,
# and builds use deploy/environments.mjs (staging / production).
# Set it to look at another API from a local panel, e.g.
# VITE_API_ORIGIN=https://quezby.kubisimsek.com
VITE_API_ORIGIN=
