{
  "name": "@quezby/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "react-native start",
    "start": "react-native start",
    "ios": "react-native run-ios --scheme Quezby --mode Debug",
    "ios:staging": "react-native run-ios --scheme 'Quezby Staging' --mode Staging.Debug",
    "android": "react-native run-android --mode localDebug --appIdSuffix local --main-activity com.kubisimsek.game.quezby.MainActivity",
    "android:staging": "react-native run-android --mode stagingDebug --appIdSuffix staging --main-activity com.kubisimsek.game.quezby.MainActivity",
    "pods": "cd ios && LANG=en_US.UTF-8 bundle exec pod install",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo coverage android/build android/app/build ios/build"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@quezby/config": "workspace:*",
    "@quezby/engine": "workspace:*",
    "@quezby/sdk": "workspace:*",
    "@quezby/types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@tanstack/react-query": "^5.101.4",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "3.2.1",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.11.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/codegen": "0.86.2",
    "@react-native/gradle-plugin": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "jest": "^29.6.3",
    "react-native-dotenv": "^4.1.1",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
