# Public mobile env — bundled into the app. Never put secrets here.
#
# One app (com.kubisimsek.game.quezby), three environments. QUEZBY_ENV says which
# API this build talks to: `pnpm switch-local`, `pnpm switch-staging` or
# `pnpm switch-production` sets it and the iOS build settings that go with it
# (docs/development/environments.md). Restart Metro after a switch.
QUEZBY_ENV=local

# Each environment's API origin, without `/api`.
#
# Local: `pnpm dev:api` serves on :8000. On the iOS simulator `localhost`
# works; on a phone or the Android emulator a Debug build swaps `localhost`
# for the host Metro served the bundle from, so keep it `localhost` unless
# the API runs on another machine.
API_URL_LOCAL=http://localhost:8000
API_URL_STAGING=https://staging-api.quezby.com
API_URL_PRODUCTION=https://api.quezby.com

# Google sign-in — public OAuth client ids (never a secret), the same in every
# environment: there is one app. The API checks a token's audience against
# these; iOS also needs the iOS client made for com.kubisimsek.game.quezby (the
# switch scripts turn it into the app's URL scheme — switch again after
# changing it). Empty: the "Google ile devam et" button is not shown.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Device integrity on Android — the number (not the id) of the Google Cloud
# project the Play Integrity API is enabled in and linked to the app in Play
# Console. Public, not a secret. Empty: the Android device check is skipped and
# the phone stays unverified. iOS needs nothing here (App Attest).
GOOGLE_CLOUD_PROJECT_NUMBER=
