# Public mobile env — bundled into the app. Never put secrets here.
#
# The native build decides which environment the app is (bundle id
# `.local` / `.staging` / none — see docs/development/environments.md).
# These are the API origins each one talks to, without `/api`.
#
# Local: `pnpm dev:api` serves on :8000. On the iOS simulator `localhost`
# works; on a phone or the Android emulator a Debug build swaps `localhost`
# for the host Metro served the bundle from, so keep it `localhost` unless
# the API runs on another machine.
API_URL_LOCAL=http://localhost:8000
API_URL_STAGING=https://staging-api.quezby.com
API_URL_PRODUCTION=https://api.quezby.com

# Google sign-in — public OAuth client ids (never a secret; see
# docs/development/environments.md). The web client id is what the API checks
# the token's audience against; iOS also needs its own client per bundle id.
# Empty: the "Google ile devam et" button is not shown.
GOOGLE_WEB_CLIENT_ID_LOCAL=
GOOGLE_WEB_CLIENT_ID_STAGING=
GOOGLE_WEB_CLIENT_ID_PRODUCTION=
GOOGLE_IOS_CLIENT_ID_LOCAL=
GOOGLE_IOS_CLIENT_ID_STAGING=
GOOGLE_IOS_CLIENT_ID_PRODUCTION=
