# Local development. Copy to .env, then: php artisan key:generate && php artisan migrate
APP_NAME=Quezby
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Below min the app must update, below latest it may.
QUEZBY_IOS_MIN_VERSION=1.0.0
QUEZBY_IOS_LATEST_VERSION=1.0.0
QUEZBY_IOS_STORE_URL=
QUEZBY_ANDROID_MIN_VERSION=1.0.0
QUEZBY_ANDROID_LATEST_VERSION=1.0.0
QUEZBY_ANDROID_STORE_URL=

QUEZBY_RUN_TTL_MINUTES=120
QUEZBY_LEADERBOARD_TIMEZONE=Europe/Istanbul

# Bundle ids Apple sign-in tokens may be for, comma-separated (com.kubisimsek.game.quezby.local here). Empty means all three Quezby apps.
APPLE_BUNDLE_IDS=
# Apple Developer team id. With the key below, deleting an account revokes Apple's grant; without it that step is skipped.
APPLE_TEAM_ID=
# Id of a key with Sign in with Apple enabled (Apple Developer > Keys).
APPLE_KEY_ID=
# That key's AuthKey_<KEY_ID>.p8, absolute or relative to the API's root. Never commit it or put it under public/.
APPLE_PRIVATE_KEY_PATH=
# Google OAuth client ids ID tokens may be for, comma-separated: the web client and the iOS client. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# Enables POST /api/v1/ops/migrate and /ops/optimize. Leave empty unless deploying.
OPS_TOKEN=

# "Günün akışı": the daily seed is an HMAC of the day with this secret, so
# nobody can know tomorrow's feed today. Empty falls back to APP_KEY — set it
# once and never change it mid-season (today's feed would change under players).
QUEZBY_DAILY_SECRET=
# Challenge #1's Istanbul day.
QUEZBY_DAILY_EPOCH=2026-09-24

# Unlocks POST /api/v1/ops/moderate (approve / reject / ban) for hosts without
# SSH. Empty means the route does not exist.
MODERATION_TOKEN=
