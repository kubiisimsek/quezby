# production. Fill in, save as apps/api/.env.production (git-ignored), then run
# ./scripts/package-api.sh production from the repository root.
APP_NAME=Quezby
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
# Must stay false: the API refuses to start in production with APP_DEBUG=true.
APP_DEBUG=false
# The API is served at https://quezby.com/api: the zip is extracted into
# public_html/api (docs/deployment/shared-hosting.md).
APP_URL=https://quezby.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The database and user created in cPanel → MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_quezby_production
DB_USERNAME=cpaneluser_quezby
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Email: the six-digit codes that verify an email sign-up, an email attached
# to an account and a password reset, in the language the player signed up in.
# Without SMTP no code reaches anyone and nobody can sign up with an email.
# cPanel → Email Accounts → Connect Devices shows the server, port and user
# (e.g. mail.quezby.com, 465 with MAIL_SCHEME=smtps, or 587 with it empty).
MAIL_MAILER=smtp
MAIL_HOST=mt-compile.guzelhosting.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@quezby.com
MAIL_PASSWORD=3FAAk5ZEK@&J
MAIL_FROM_ADDRESS=no-reply@quezby.com
MAIL_FROM_NAME=Quezby

QUEZBY_IOS_MIN_VERSION=1.0.0
QUEZBY_IOS_LATEST_VERSION=1.0.0
QUEZBY_IOS_STORE_URL=
QUEZBY_ANDROID_MIN_VERSION=1.0.0
QUEZBY_ANDROID_LATEST_VERSION=1.0.0
QUEZBY_ANDROID_STORE_URL=

QUEZBY_RUN_TTL_MINUTES=120
QUEZBY_LEADERBOARD_TIMEZONE=Europe/Istanbul
# Counted Normal or Günlük runs (ranked, scoring) before Dereceli — Elo and a league — opens.
QUEZBY_LEAGUE_UNLOCK_RUNS=20
# Hours a friend has to answer a VS before it lapses and counts for nobody.
QUEZBY_DUEL_EXPIRE_HOURS=48
# Days the inbox keeps its messages before they are pruned.
QUEZBY_INBOX_KEEP_DAYS=90

# Push notifications (Firebase Cloud Messaging). Nothing is sent until both
# are set: the Firebase project's id, and its service account's JSON key —
# absolute or relative to the API's root. Upload the key to
# storage/app/private/ with File Manager; never commit it.
QUEZBY_PUSH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Bundle ids Apple sign-in tokens and App Attest keys may be for, comma-separated. Empty means Quezby's one app, com.kubisimsek.game.quezby (every environment).
APPLE_BUNDLE_IDS=
# Apple Developer team id. With the key below, deleting an account revokes Apple's grant; without it that step is skipped.
# App Attest needs it too (keys are for TEAM_ID.bundle id): without it, iOS device checks answer "unavailable".
APPLE_TEAM_ID=
# Id of a key with Sign in with Apple enabled (Apple Developer > Keys).
APPLE_KEY_ID=
# That key's AuthKey_<KEY_ID>.p8, absolute or relative to the API's root. Never commit it or put it under public/.
APPLE_PRIVATE_KEY_PATH=
# Google OAuth client ids ID tokens may be for, comma-separated: the web client and the iOS client. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# Only while deploying without SSH: a long random string (openssl rand -hex 32).
# Empty the moment migrations have run — see docs/deployment/shared-hosting.md.
OPS_TOKEN=

# "Günün akışı": the daily seed is an HMAC of the day with this secret, so
# nobody can know tomorrow's feed today. Empty falls back to APP_KEY — set it
# once and never change it mid-season (today's feed would change under players).
QUEZBY_DAILY_SECRET=
# Challenge #1's Istanbul day.
QUEZBY_DAILY_EPOCH=2026-09-24

# Unlocks POST /api/v1/ops/moderate (approve / reject / ban) for hosts without
# SSH. Empty means the route does not exist.
MODERATION_TOKEN=

# The admin panel (apps/admin): how long a panel session lasts, in hours.
QUEZBY_ADMIN_TOKEN_HOURS=12

# The panel's Loglar page (`system_logs`): days a row is kept, by level. API
# errors, failed calls to Firebase/Google/Apple, push decisions and phones'
# errors — independent of LOG_LEVEL, which only governs
# storage/logs/laravel*.log. The daily counts (`system_log_days`) are kept for good.
QUEZBY_LOG_KEEP_ERROR_DAYS=90
QUEZBY_LOG_KEEP_WARNING_DAYS=14
QUEZBY_LOG_KEEP_INFO_DAYS=3

# Usage analytics (docs/product/analytics.md) — only for players who said yes.
# false stops collecting at once; the app is told to keep nothing for a day.
QUEZBY_ANALYTICS_ENABLED=true
# Of every 1000 consenting players, how many are kept: the valve for a flood.
QUEZBY_ANALYTICS_SAMPLE=1000
# Days visits (with their screen journeys, at least 8) and per-player days stay.
QUEZBY_ANALYTICS_VISIT_DAYS=30
QUEZBY_ANALYTICS_DAY_DAYS=90
# The device registry, kept for every player: days an unseen phone stays.
QUEZBY_DEVICE_DAYS=180

# Device integrity (anti-cheat v3): Play Integrity on Android, App Attest on iOS.
# off | log | enforce. `enforce` (production) keeps runs from phones that fail
# the check — rooted, emulators, changed apps — off every board, and holds a top
# score from a phone without a verdict for review; `log` (local, staging) only
# records each run's verdict; `off` checks nothing.
QUEZBY_INTEGRITY_MODE=enforce
# Android packages whose Play Integrity tokens count, comma-separated.
# Empty means Quezby's one app, com.kubisimsek.game.quezby (every environment).
PLAY_INTEGRITY_PACKAGES=
# The Google Cloud service account's JSON key, allowed to call the Play Integrity
# API (its project linked to the app in Play Console). Absolute, or relative to
# the API's root: keep it at storage/app/private/play-integrity.json — never
# commit it or put it under public/. Empty: Android checks answer "unavailable".
GOOGLE_PLAY_INTEGRITY_CREDENTIALS=
# App Attest environments whose keys count, comma-separated: development (Xcode
# builds) and/or production (TestFlight and the App Store). Empty means production.
APP_ATTEST_ENVIRONMENTS=production
